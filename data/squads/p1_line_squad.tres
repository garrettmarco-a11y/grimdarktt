[gd_resource type="Resource" script_class="SquadData" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/resources/SquadData.gd" id="1_squad"]
[ext_resource type="Script" path="res://scripts/resources/UnitProfile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/resources/SquadModel.gd" id="3_model"]
[ext_resource type="Resource" path="res://data/weapons/heavy_gun.tres" id="w_heavy_gun"]
[ext_resource type="Resource" path="res://data/weapons/pistol.tres" id="w_pistol"]
[ext_resource type="Resource" path="res://data/weapons/rifle.tres" id="w_rifle"]

[sub_resource type="Resource" id="Resource_profile"]
script = ExtResource("2_profile")
movement = 6.0
quality = 4
toughness = 3
wounds = 1
leadership = 7

[sub_resource type="Resource" id="Resource_model_0"]
script = ExtResource("3_model")
model_name = "Sergeant"
weapon = ExtResource("w_pistol")
formation_offset = Vector2(0, 0)

[sub_resource type="Resource" id="Resource_model_1"]
script = ExtResource("3_model")
model_name = "Trooper"
weapon = ExtResource("w_rifle")
formation_offset = Vector2(-1.5, 1.5)

[sub_resource type="Resource" id="Resource_model_2"]
script = ExtResource("3_model")
model_name = "Trooper"
weapon = ExtResource("w_rifle")
formation_offset = Vector2(1.5, 1.5)

[sub_resource type="Resource" id="Resource_model_3"]
script = ExtResource("3_model")
model_name = "Gunner"
weapon = ExtResource("w_heavy_gun")
formation_offset = Vector2(0, -1.75)

[resource]
script = ExtResource("1_squad")
squad_id = &"p1_line_squad"
display_name = "Line Squad"
player = 1
profile = SubResource("Resource_profile")
models = Array[ExtResource("3_model")]([SubResource("Resource_model_0"), SubResource("Resource_model_1"), SubResource("Resource_model_2"), SubResource("Resource_model_3")])
